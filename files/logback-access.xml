<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="5 seconds" debug="true">
<springProperty scope="context" name="LOG_PATH" source="logging.path"/>

    <appender name="ACCESS-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/[[application_execute]]-access.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/[[application_execute]]-access.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%header{X-Forwarded-For} %clientHost [%date{dd-MMM-yyyy HH:mm:ss.SSS}] "%requestURL" "%header{Referer}" "%header{User-Agent}" %statusCode %bytesSent %elapsedTime</pattern>
        </encoder>
    </appender>
 
    <appender-ref ref="ACCESS-FILE" />
    
</configuration>
